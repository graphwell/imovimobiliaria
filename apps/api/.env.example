# ─── Banco de dados (Supabase Postgres) ────────────────────────────────────────
# Connection pooler (pgbouncer) — usada em runtime pela API/funções serverless
# Settings → Database → Connection pooling (modo "Transaction") no painel do Supabase
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:SENHA@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexão direta (sem pooler) — necessária só para rodar migrations/db push
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:SENHA@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres"

# ─── Servidor ─────────────────────────────────────────────────────────────────
JWT_SECRET="troque_por_uma_chave_segura_em_producao"
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN="http://localhost:3000"
NODE_ENV=development

# ─── Vercel Cron ───────────────────────────────────────────────────────────────
# Secret usado para autenticar chamadas às rotas /api/cron/*.
# A Vercel injeta automaticamente "Authorization: Bearer $CRON_SECRET" nos seus
# próprios Cron Jobs quando essa env var existe. Para gatilhos externos (ex:
# cron-job.org) configure o mesmo header manualmente.
CRON_SECRET="gere_um_valor_aleatorio_longo"

# ─── Admin / Notificações ─────────────────────────────────────────────────────
ADMIN_EMAIL="imovimobiliariace@gmail.com"

# ─── Google OAuth 2.0 (Google Meu Negócio + Search Console) ──────────────────
# Criar em: console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# URI de redirecionamento (deve estar cadastrado no Google Cloud Console):
GOOGLE_REDIRECT_URI="https://api.somar.ia.br/google/callback"
# Para dev local:
# GOOGLE_REDIRECT_URI="http://localhost:3001/google/callback"

# ─── Google Sheets (conta de serviço — não precisa de OAuth) ─────────────────
# Conteúdo INTEIRO do JSON da conta de serviço, em uma única linha (sem quebras).
# Em ambiente serverless (Vercel) não há disco para ler um arquivo, então as
# credenciais viajam como variável de ambiente e são lidas via JSON.parse.
# Gere em: console.cloud.google.com → IAM & Admin → Service Accounts → Keys
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'
# ID da planilha criada automaticamente na 1ª execução (ver logs da função):
GOOGLE_SHEETS_ID=""

# ─── Gmail / SMTP ─────────────────────────────────────────────────────────────
# Crie Senha de App em: myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="imovimobiliariace@gmail.com"
SMTP_PASS=""   # Senha de App do Gmail (16 chars)

# ─── Google Analytics 4 ───────────────────────────────────────────────────────
# Measurement ID: GA4 Admin → Streams → ID de medição (G-XXXXXX)
GA4_MEASUREMENT_ID="G-XXXXXXXXXX"
# API Secret: GA4 Admin → Streams → Measurement Protocol → Criar segredo
GA4_API_SECRET=""

# ─── Supabase Storage ─────────────────────────────────────────────────────────
# Projeto: supabase.com → Settings → API
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""   # service_role key (nunca expor no frontend)
SUPABASE_ANON_KEY=""      # anon/public key
