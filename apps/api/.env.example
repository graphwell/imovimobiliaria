# ─── Banco de dados ───────────────────────────────────────────────────────────
DATABASE_URL="postgresql://imov:imov_secret@localhost:5432/imov_db"
REDIS_URL="redis://localhost:6379"

# ─── Servidor ─────────────────────────────────────────────────────────────────
JWT_SECRET="troque_por_uma_chave_segura_em_producao"
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN="http://localhost:3000"
NODE_ENV=development

# ─── Admin / Notificações ─────────────────────────────────────────────────────
# Email do administrador que receberá alertas de leads e terá acesso à planilha
ADMIN_EMAIL="admin@suaempresa.com.br"

# ─── Google Sheets ────────────────────────────────────────────────────────────
# Caminho para o JSON da conta de serviço (padrão: secrets/google-service-account.json)
# GOOGLE_APPLICATION_CREDENTIALS="./secrets/google-service-account.json"

# ID da planilha "IMOV — Leads" (criada automaticamente na 1ª execução)
# Após a 1ª execução, o ID será exibido nos logs — adicione-o aqui
GOOGLE_SHEETS_ID=""

# ─── Gmail / SMTP ────────────────────────────────────────────────────────────
# Para Gmail: ative a verificação em 2 etapas e gere uma Senha de App em
# https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="seu-email@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"   # Senha de App do Gmail (16 chars sem espaço)

# ─── Google Analytics 4 (Measurement Protocol) ───────────────────────────────
# Measurement ID: Painel GA4 → Admin → Streams de dados → ID de medição (G-XXXXXX)
GA4_MEASUREMENT_ID="G-XXXXXXXXXX"
# API Secret: Painel GA4 → Admin → Streams → Measurement Protocol → Criar segredo
GA4_API_SECRET=""

# ─── (Opcional) OAuth para Search Console ────────────────────────────────────
# Usado apenas se integração com Search Console for adicionada futuramente
# GOOGLE_OAUTH_CLIENT_ID="585124642667-xxx.apps.googleusercontent.com"
# GOOGLE_OAUTH_CLIENT_SECRET="GOCSPX-xxx"
