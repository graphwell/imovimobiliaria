# ─── Banco de dados ───────────────────────────────────────────────────────────
DATABASE_URL="postgresql://imov:imov_secret@localhost:5432/imov_db"
REDIS_URL="redis://localhost:6379"

# ─── Servidor ─────────────────────────────────────────────────────────────────
JWT_SECRET="troque_por_uma_chave_segura_em_producao"
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN="http://localhost:3000"
NODE_ENV=development

# ─── Admin / Notificações ─────────────────────────────────────────────────────
ADMIN_EMAIL="imovimobiliariace@gmail.com"

# ─── Google OAuth 2.0 (Google Meu Negócio + Search Console) ──────────────────
# Criar em: console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client
GOOGLE_CLIENT_ID="585124642667-knvo7gn9mb90on4958sdu06o66udq1vh.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET=""              # regenerar após expor em chat
# URI de redirecionamento (deve estar cadastrado no Google Cloud Console):
GOOGLE_REDIRECT_URI="https://api.somar.ia.br/admin/google/callback"
# Para dev local:
# GOOGLE_REDIRECT_URI="http://localhost:3001/admin/google/callback"

# ─── Google Sheets (conta de serviço — não precisa de OAuth) ─────────────────
# Credenciais em: apps/api/secrets/google-service-account.json (nunca commitar)
GOOGLE_APPLICATION_CREDENTIALS="./secrets/google-service-account.json"
# ID da planilha criada automaticamente na 1ª execução (ver logs pm2):
GOOGLE_SHEETS_ID=""

# ─── Gmail / SMTP ─────────────────────────────────────────────────────────────
# Crie Senha de App em: myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="imovimobiliariace@gmail.com"
SMTP_PASS=""   # Senha de App do Gmail (16 chars)

# ─── Google Analytics 4 ───────────────────────────────────────────────────────
# Measurement ID: GA4 Admin → Streams → ID de medição (G-XXXXXX)
GA4_MEASUREMENT_ID="G-XXXXXXXXXX"
# API Secret: GA4 Admin → Streams → Measurement Protocol → Criar segredo
GA4_API_SECRET=""
